@page
@model OnlineAuctionSystem.Pages.Seller.DashboardModel
@{
    ViewData["Title"] = "Seller Dashboard";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-secondary text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active text-warning" aria-current="page">Seller Dashboard</li>
                </ol>
            </nav>
            <h1 class="display-4 fw-bold mb-0">Seller Dashboard</h1>
            <p class="text-secondary mb-0">Manage your listings, monitor bids and track your performance.</p>
        </div>
        <div>
            <a asp-page="/Seller/CreateAuction" class="btn btn-warning px-4 py-2 text-dark fw-semibold">
                <i class="bi bi-plus-lg me-2"></i>Post New Item
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card bg-dark border-secondary h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                        <i class="bi bi-lightning-charge fs-4"></i>
                    </div>
                    <span class="text-secondary text-uppercase fw-semibold small tracking-wider">Active Listings</span>
                </div>
                <h2 class="display-5 fw-bold mb-0">@Model.TotalActiveAuctions</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle p-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <span class="text-secondary text-uppercase fw-semibold small tracking-wider">Total Bids Received</span>
                </div>
                <h2 class="display-5 fw-bold mb-0">@Model.TotalBidsReceived</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                    <span class="text-secondary text-uppercase fw-semibold small tracking-wider">Potential Earnings</span>
                </div>
                <h2 class="display-5 fw-bold mb-0">$@Model.TotalPotentialEarnings.ToString("N0")</h2>
            </div>
        </div>
    </div>

    <!-- Recent Listings -->
    <div class="card bg-dark border-secondary border-opacity-50 shadow-sm overflow-hidden">
        <div class="card-header bg-dark border-secondary py-3 d-flex justify-content-between align-items-center">
            <h3 class="h5 mb-0 font-display">Recent Listings</h3>
            <a asp-page="/Seller/MyAuctions" class="btn btn-link link-warning btn-sm text-decoration-none p-0">View All Listings</a>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Item Details</th>
                        <th class="py-3">Current Bid</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Ends At</th>
                        <th class="pe-4 text-end py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top border-secondary border-opacity-25">
                    @if (!Model.MyAuctions.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-5 text-center text-secondary">
                                <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                                <p class="mb-0">You have no listings yet. <a asp-page="/Seller/CreateAuction" class="text-warning">Post your first item!</a></p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var auction in Model.MyAuctions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@auction.ImageUrl" alt="@auction.Title" class="rounded object-fit-cover" style="width: 48px; height: 48px;">
                                        <div>
                                            <div class="fw-semibold text-light">@auction.Title</div>
                                            <div class="small text-secondary">@auction.Category</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold">$@auction.CurrentBid.ToString("N0")</div>
                                    <div class="small text-secondary">@auction.BidCount bids</div>
                                </td>
                                <td>
                                    @if (auction.IsLive && auction.EndsAt > DateTime.UtcNow)
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">
                                            <span class="spinner-grow spinner-grow-sm me-1" role="status"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">Ended</span>
                                    }
                                </td>
                                <td class="small">@auction.EndsAt.ToString("MMM dd, HH:mm")</td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group">
                                        <a href="/Seller/AuctionDetails?id=@auction.Id" class="btn btn-outline-secondary btn-sm" title="Monitor Bids"><i class="bi bi-graph-up"></i></a>
                                        <a href="/Seller/EditAuction?id=@auction.Id" class="btn btn-outline-secondary btn-sm" title="Edit Listing"><i class="bi bi-pencil"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
