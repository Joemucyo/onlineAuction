@page
@model OnlineAuctionSystem.Pages.Auctions.IndexModel
@{
    ViewData["Title"] = "All Auctions";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <p class="small text-uppercase text-warning fw-semibold mb-2">Marketplace</p>
        <h1 class="font-display display-5 fw-light mb-3">All Auctions</h1>
        <p class="text-secondary mx-auto" style="max-width: 36rem;">
