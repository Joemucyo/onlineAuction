@page
@model OnlineAuctionSystem.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["AdminTitle"] = "Dashboard Overview";
    Layout = "_AdminLayout";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-secondary h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:3rem;height:3rem;background:rgba(255,193,7,0.12)">
                    <i class="bi bi-people fs-5 text-warning"></i>
                </div>
                <div>
                    <div class="small text-secondary">Total Buyers</div>
                    <div class="fs-4 fw-bold font-display">@Model.TotalBuyers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-secondary h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:3rem;height:3rem;background:rgba(255,193,7,0.12)">
                    <i class="bi bi-shop fs-5 text-warning"></i>
                </div>
                <div>
                    <div class="small text-secondary">Total Sellers</div>
                    <div class="fs-4 fw-bold font-display">@Model.TotalSellers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-secondary h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:3rem;height:3rem;background:rgba(255,193,7,0.12)">
                    <i class="bi bi-slash-circle fs-5 text-warning"></i>
                </div>
                <div>
                    <div class="small text-secondary">Suspended Users</div>
                    <div class="fs-4 fw-bold font-display @(Model.SuspendedUsers > 0 ? "text-warning" : "text-body")">@Model.SuspendedUsers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-secondary h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:3rem;height:3rem;background:rgba(255,193,7,0.12)">
                    <i class="bi bi-envelope-x fs-5 text-warning"></i>
                </div>
                <div>
                    <div class="small text-secondary">Unverified Emails</div>
                    <div class="fs-4 fw-bold font-display @(Model.UnverifiedUsers > 0 ? "text-warning" : "text-body")">@Model.UnverifiedUsers</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-secondary mb-4">
    <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
        <h6 class="font-display mb-0">Recently Joined Users</h6>
        <a asp-page="/Admin/Users" class="btn btn-outline-warning btn-sm">View All Users</a>
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Email Verified</th>
                    <th>Status</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentUsers.Any())
                {
                    @foreach (var user in Model.RecentUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td class="text-secondary small">@user.Email</td>
                            <td>
                                @if (user.Role == "Seller")
                                {
                                    <span class="badge text-bg-warning text-dark">Seller</span>
                                }
                                else if (user.Role == "Admin")
                                {
                                    <span class="badge text-bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Buyer</span>
                                }
                            </td>
                            <td>
                                @if (user.IsEmailVerified)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                }
                            </td>
                            <td>
                                @if (user.IsSuspended)
                                {
                                    <span class="badge bg-danger">Suspended</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-secondary small">Not available</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">No users have registered yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-secondary">
            <div class="card-body text-center p-4">
                <div class="rounded-3 d-inline-flex align-items-center justify-content-center" style="width:3rem;height:3rem;background:rgba(255,193,7,0.12)">
                    <i class="bi bi-person-check fs-5 text-warning"></i>
                </div>
                <h6 class="font-display mt-3 mb-1">Manage Users</h6>
                <p class="small text-secondary mb-3">View, suspend or ban user accounts</p>
                <a asp-page="/Admin/Users" class="btn btn-outline-warning btn-sm">Go to Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-secondary">
            <div class="card-body text-center p-4">
                <div class="rounded-3 d-inline-flex align-items-center justify-content-center" style="width:3rem;height:3rem;background:rgba(255,193,7,0.12)">
                    <i class="bi bi-tag fs-5 text-warning"></i>
                </div>
                <h6 class="font-display mt-3 mb-1">Review Listings</h6>
                <p class="small text-secondary mb-3">Approve or reject seller auction listings</p>
                <a asp-page="/Admin/Listings" class="btn btn-outline-warning btn-sm">Go to Listings</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-secondary">
            <div class="card-body text-center p-4">
                <div class="rounded-3 d-inline-flex align-items-center justify-content-center" style="width:3rem;height:3rem;background:rgba(255,193,7,0.12)">
                    <i class="bi bi-flag fs-5 text-warning"></i>
                </div>
                <h6 class="font-display mt-3 mb-1">Open Disputes</h6>
                <p class="small text-secondary mb-3">Review and resolve buyer-seller disputes</p>
                <a asp-page="/Admin/Disputes" class="btn btn-outline-warning btn-sm">Go to Disputes</a>
            </div>
        </div>
    </div>
</div>
