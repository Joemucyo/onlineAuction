<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GavelPro Auctions</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: 'DM Sans', system-ui, sans-serif; }
        h1, h2, h3, h4, .font-display { font-family: 'Cormorant Garamond', Georgia, serif; }
    </style>
</head>
<body class="bg-body text-body has-fixed-nav">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 font-display fw-semibold" asp-page="/Index">
                <span class="bg-warning text-dark rounded-2 d-inline-flex align-items-center justify-content-center" style="width:2.25rem;height:2.25rem;">
                    <i class="bi bi-hammer"></i>
                </span>
                GavelPro
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#auctions">Live Auctions</a></li>
                    <li class="nav-item"><a class="nav-link" href="#how-it-works">How It Works</a></li>
                </ul>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-light btn-sm" asp-page="/Account/Login">Sign In</a>
                    <a class="btn btn-warning btn-sm text-dark" asp-page="/Account/Register">Register</a>
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="border-top border-secondary bg-dark text-light mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-3 font-display fs-4 fw-semibold">
                        <span class="bg-warning text-dark rounded-2 d-inline-flex align-items-center justify-content-center" style="width:2.25rem;height:2.25rem;">
                            <i class="bi bi-hammer"></i>
                        </span>
                        GavelPro
                    </div>
                    <p class="text-secondary small mb-0">The premier destination for online auctions. Connecting serious buyers with extraordinary items.</p>
                </div>
                <div class="col-lg-7">
                    <div class="row">
                        <div class="col-md-4">
                            <h2 class="h6 text-uppercase text-secondary mb-3">Platform</h2>
                            <ul class="list-unstyled small">
                                <li class="mb-2"><a class="link-light link-underline-opacity-0" href="#auctions">Browse Auctions</a></li>
                                <li class="mb-2"><a class="link-light link-underline-opacity-0" href="#">How Bidding Works</a></li>
                                <li class="mb-2"><a class="link-light link-underline-opacity-0" href="#">Bid Security</a></li>
                                <li><a class="link-light link-underline-opacity-0" href="#">Winners Gallery</a></li>
                            </ul>
                        </div>
                        <div class="col-md-4">
                            <h2 class="h6 text-uppercase text-secondary mb-3">Auctioneers</h2>
                            <ul class="list-unstyled small">
                                <li class="mb-2"><a class="link-light link-underline-opacity-0" asp-page="/Account/Login">Auctioneer Login</a></li>
                                <li class="mb-2"><a class="link-light link-underline-opacity-0" asp-page="/Auctions/Index">Post an Item</a></li>
                                <li><a class="link-light link-underline-opacity-0" href="#">Manage Listings</a></li>
                            </ul>
                        </div>
                        <div class="col-md-4">
                            <h2 class="h6 text-uppercase text-secondary mb-3">Support</h2>
                            <ul class="list-unstyled small">
                                <li class="mb-2"><a class="link-light link-underline-opacity-0" href="#">Help Centre</a></li>
                                <li class="mb-2"><a class="link-light link-underline-opacity-0" href="#">Contact Us</a></li>
                                <li class="mb-2"><a class="link-light link-underline-opacity-0" href="#">Terms of Service</a></li>
                                <li><a class="link-light link-underline-opacity-0" asp-page="/Privacy">Privacy Policy</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="border-top border-secondary py-3">
            <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-secondary">
                <span>&copy; @DateTime.Now.Year GavelPro Auctions. All rights reserved.</span>
                <div class="d-flex gap-3 fs-5">
                    <a href="#" class="link-secondary" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="link-secondary" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="link-secondary" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="link-secondary" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/auction.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
