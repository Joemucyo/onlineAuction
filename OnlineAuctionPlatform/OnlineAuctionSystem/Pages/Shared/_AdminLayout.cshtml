<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GavelPro Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'DM Sans', system-ui, sans-serif;
        }

        h1, h2, h3, h4, .font-display {
            font-family: 'Cormorant Garamond', Georgia, serif;
        }

        .admin-sidebar {
            width: 260px;
            height: 100vh;
            overflow-y: auto;
        }

        .admin-content-wrapper {
            margin-left: 260px;
        }

        .admin-nav-link:hover {
            background-color: rgba(255, 193, 7, 0.08);
            color: #ffc107 !important;
            border-left: 3px solid #ffc107;
        }

        .admin-nav-link.active {
            background-color: rgba(255, 193, 7, 0.12);
            color: #ffc107 !important;
            border-left: 3px solid #ffc107;
        }
    </style>
</head>
<body class="bg-body text-body">
    <div class="d-flex min-vh-100">
        <aside class="admin-sidebar position-fixed top-0 start-0 bottom-0 bg-dark border-end border-secondary d-flex flex-column">
            <div class="p-4">
                <a class="d-flex align-items-center gap-2 font-display fw-semibold fs-4 text-decoration-none text-light" asp-page="/Admin/Dashboard">
                    <span class="bg-warning text-dark rounded-2 d-inline-flex align-items-center justify-content-center" style="width:2.25rem;height:2.25rem;">
                        <i class="bi bi-hammer"></i>
                    </span>
                    GavelPro
                </a>
                <div class="text-warning small mt-1">Admin Portal</div>
            </div>

            <hr class="border-secondary m-0" />

            <nav class="py-2 flex-grow-1">
                <a class="admin-nav-link d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-secondary" asp-page="/Admin/Dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
                <a class="admin-nav-link d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-secondary" asp-page="/Admin/Users">
                    <i class="bi bi-people"></i>
                    <span>Users</span>
                </a>
                <a class="admin-nav-link d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-secondary" asp-page="/Admin/Auctions">
                    <i class="bi bi-hammer"></i>
                    <span>Auctions</span>
                </a>
                <a class="admin-nav-link d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-secondary" asp-page="/Admin/Listings">
                    <i class="bi bi-tag"></i>
                    <span>Listings</span>
                </a>
                <a class="admin-nav-link d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-secondary" asp-page="/Admin/Disputes">
                    <i class="bi bi-flag"></i>
                    <span>Disputes</span>
                </a>
                <a class="admin-nav-link d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-secondary" asp-page="/Admin/Categories">
                    <i class="bi bi-grid"></i>
                    <span>Categories</span>
                </a>
                <a class="admin-nav-link d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-secondary" asp-page="/Admin/Reports">
                    <i class="bi bi-bar-chart"></i>
                    <span>Reports</span>
                </a>
                <a class="admin-nav-link d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-secondary" asp-page="/Admin/Settings">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </nav>

            <div class="mt-auto p-4">
                <hr class="border-secondary mt-0" />
                <div class="small text-secondary mb-3">@User.Identity?.Name</div>
                <form method="post" asp-page="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-box-arrow-right"></i> Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <div class="admin-content-wrapper flex-grow-1 d-flex flex-column">
            <div class="border-bottom border-secondary bg-dark d-flex align-items-center justify-content-between px-4" style="height:56px;">
                <h1 class="font-display h5 mb-0">@ViewData["AdminTitle"]</h1>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge text-bg-warning text-dark">Admin</span>
                    <span class="small text-secondary">@User.Identity?.Name</span>
                </div>
            </div>

            <main class="flex-grow-1 overflow-auto bg-body p-4 d-flex flex-column">
                <div class="flex-grow-1">
                    @RenderBody()
                </div>
                <footer class="small text-secondary text-center py-3 border-top border-secondary mt-4">
                    GavelPro Admin Portal © @DateTime.Now.Year
                </footer>
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script>
        const currentPath = window.location.pathname.toLowerCase();
        document.querySelectorAll(".admin-nav-link").forEach(link => {
            const href = (link.getAttribute("href") || "").toLowerCase();
            if (href === currentPath) {
                link.classList.add("active");
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
