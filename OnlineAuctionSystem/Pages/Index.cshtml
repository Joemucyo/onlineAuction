    <div class="categories-grid">
        <a class="cat-card" href="#">
            <i class="bi bi-car-front-fill"></i>
            <span>Classic Automobiles</span>
        </a>
        <a class="cat-card" href="#">
            <i class="bi bi-palette-fill"></i>
            <span>Fine Art</span>
        </a>
        <a class="cat-card" href="#">
            <i class="bi bi-watch"></i>
            <span>Luxury Watches</span>
        </a>
        <a class="cat-card" href="#">
            <i class="bi bi-gem"></i>
            <span>Jewellery</span>
        </a>
        <a class="cat-card" href="#">
            <i class="bi bi-book-fill"></i>
            <span>Rare Books</span>
        </a>
        <a class="cat-card" href="#">
            <i class="bi bi-house-fill"></i>
            <span>Real Estate</span>
        </a>
        <a class="cat-card" href="#">
            <i class="bi bi-music-note-beamed"></i>
            <span>Instruments</span>
        </a>
        <a class="cat-card" href="#">
            <i class="bi bi-grid-fill"></i>
            <span>All Categories</span>
        </a>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     CTA BANNER
═══════════════════════════════════════════ -->
<section class="cta-banner">
    <div class="cta-banner__grain"></div>
    <div class="cta-banner__inner">
        <h2 class="cta-banner__title">
            Ready to Bid on<br /><em>Extraordinary Things?</em>
        </h2>
        <p class="cta-banner__sub">
            Join @Model.Stats.RegisteredBidders.ToString("N0") bidders already on the platform.
            Registration is free and takes under 2 minutes.
        </p>
        <div class="cta-banner__actions">
            <a class="ap-btn ap-btn--gold ap-btn--lg" asp-page="/Account/Register">
                <i class="bi bi-person-plus"></i> Get Started Free
            </a>
            <a class="ap-btn ap-btn--outline ap-btn--lg" href="#how-it-works">
                Learn How It Works
            </a>
        </div>
    </div>
</section>
