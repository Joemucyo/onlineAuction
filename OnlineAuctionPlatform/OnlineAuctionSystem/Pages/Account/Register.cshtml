@page
@model OnlineAuctionSystem.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <p class="small text-uppercase text-warning fw-semibold mb-2">Join GavelPro</p>
            <h1 class="font-display display-5 fw-light mb-3">Create your bidder account</h1>
            <p class="text-secondary mb-4">
                Registration and KYC onboarding are next in the implementation roadmap. This page is ready as the entry point.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-outline-light" asp-page="/Index">Back to Home</a>
                <a class="btn btn-outline-warning" asp-page="/Account/Login">Already have an account? Sign in</a>
            </div>
        </div>
    </div>
</div>
