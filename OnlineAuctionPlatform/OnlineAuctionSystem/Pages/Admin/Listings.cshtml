@page
@model OnlineAuctionSystem.Pages.Admin.ListingsModel
@{
    ViewData["Title"] = "Listing Approvals";
    ViewData["AdminTitle"] = "Listing Approvals";
    Layout = "_AdminLayout";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-3">
        <h4 class="mb-0">Pending Approval</h4>
        <span class="badge text-bg-warning text-dark">@Model.PendingListings.Count</span>
    </div>

    @if (Model.PendingListings.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr class="border-bottom border-secondary">
                        <th>Thumbnail</th>
                        <th>Title & Description</th>
                        <th>Seller</th>
                        <th>Starting Bid</th>
                        <th>Posted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in Model.PendingListings)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(listing.ImageUrl))
                                {
                                    <img src="@listing.ImageUrl" alt="@listing.Title" class="rounded" style="width:48px;height:48px;object-fit:cover;">
                                }
                                else
                                {
                                    <div class="bg-secondary rounded" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-image text-secondary"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong>@listing.Title</strong>
                                <br>
                                <small class="text-secondary">
                                    @(listing.Description.Length > 80 ? listing.Description.Substring(0, 80) + "..." : listing.Description)
                                </small>
                            </td>
                            <td>
                                @listing.AuctioneerName
                            </td>
                            <td>
                                $@listing.StartingBid.ToString("N0")
                            </td>
                            <td>
                                <small>@listing.StartsAt.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Approve" class="d-inline">
                                    <input type="hidden" name="auctionId" value="@listing.Id">
                                    <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                </form>
                                <span class="text-secondary">|</span>
                                <form method="post" asp-page-handler="Reject" class="d-inline" onsubmit="return confirm('Reject and delete this listing?');">
                                    <input type="hidden" name="auctionId" value="@listing.Id">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-secondary">No listings are waiting for approval.</p>
    }
</div>

<hr class="border-secondary">

<div class="mt-4">
    <h4 class="mb-3">Approved & Live Listings</h4>

    @if (Model.ApprovedListings.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr class="border-bottom border-secondary">
                        <th>Thumbnail</th>
                        <th>Title & Description</th>
                        <th>Seller</th>
                        <th>Current Bid</th>
                        <th>Ends At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in Model.ApprovedListings)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(listing.ImageUrl))
                                {
                                    <img src="@listing.ImageUrl" alt="@listing.Title" class="rounded" style="width:48px;height:48px;object-fit:cover;">
                                }
                                else
                                {
                                    <div class="bg-secondary rounded" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-image text-secondary"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong>@listing.Title</strong>
                                <br>
                                <small class="text-secondary">
                                    @(listing.Description.Length > 80 ? listing.Description.Substring(0, 80) + "..." : listing.Description)
                                </small>
                            </td>
                            <td>
                                @listing.AuctioneerName
                            </td>
                            <td>
                                <span class="text-warning">${@listing.CurrentBid.ToString("N0")}</span>
                            </td>
                            <td>
                                <small>@listing.EndsAt.ToString("MMM dd, yyyy HH:mm")</small>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Reject" class="d-inline" onsubmit="return confirm('Remove this listing from live?');">
                                    <input type="hidden" name="auctionId" value="@listing.Id">
                                    <button type="submit" class="btn btn-outline-warning btn-sm">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-secondary">No approved listings yet.</p>
    }
</div>
