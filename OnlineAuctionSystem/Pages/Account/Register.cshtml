@page
@model OnlineAuctionSystem.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="section">
    <div class="section__header">
        <div class="section__eyebrow">Join GavelPro</div>
        <h1 class="section__title">Create your bidder account</h1>
        <p class="section__desc">
            Registration and KYC onboarding are next in the implementation roadmap. This page is ready as the entry point.
        </p>
    </div>
    <div class="section__more">
        <a class="ap-btn ap-btn--outline" asp-page="/Account/Login">Already have an account? Sign in</a>
    </div>
</section>
