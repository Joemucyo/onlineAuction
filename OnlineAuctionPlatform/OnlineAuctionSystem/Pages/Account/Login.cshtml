@page
@model OnlineAuctionSystem.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <p class="small text-uppercase text-warning fw-semibold mb-2">Account Access</p>
            <h1 class="font-display display-5 fw-light mb-3">Sign in to place bids</h1>
            <p class="text-secondary mb-4">
                Authentication is being finalized. Use this placeholder screen while the full login flow is under development.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-outline-light" asp-page="/Index">Back to Home</a>
                <a class="btn btn-warning text-dark" asp-page="/Account/Register">Create account</a>
            </div>
        </div>
    </div>
</div>
