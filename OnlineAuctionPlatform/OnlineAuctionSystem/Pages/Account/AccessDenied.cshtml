@page
@model OnlineAuctionSystem.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <p class="small text-uppercase text-warning fw-semibold mb-2">Access Denied</p>
                <h1 class="font-display display-6 fw-light mb-2">You do not have permission</h1>
                <p class="text-secondary mb-0">You do not have permission to view this page.</p>
            </div>

            <div class="card bg-body-tertiary border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center">
                    <a class="btn btn-warning btn-lg text-dark fw-semibold" asp-page="/Account/Login">Go to Sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>

